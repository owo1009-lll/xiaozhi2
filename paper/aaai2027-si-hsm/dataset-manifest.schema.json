{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Erhu-PA Dataset Manifest",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "title",
          "subset",
          "mixturePath",
          "scorePath",
          "licenseStatus",
          "gtStatus"
        ],
        "properties": {
          "itemId": { "type": "string" },
          "title": { "type": "string" },
          "subset": {
            "type": "string",
            "enum": ["piano", "orch_light", "orch_heavy"]
          },
          "mixturePath": { "type": "string" },
          "targetPath": { "type": "string" },
          "accompanimentPath": { "type": "string" },
          "scorePath": { "type": "string" },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "sampleRate": { "type": "integer", "minimum": 8000 },
          "channels": { "type": "integer", "minimum": 1 },
          "licenseStatus": {
            "type": "string",
            "enum": ["redistributable", "internal_only", "metadata_only", "unknown"]
          },
          "gtStatus": {
            "type": "string",
            "enum": ["clean_stems", "synthetic_mix", "no_reference", "unknown"]
          },
          "sourceType": {
            "type": "string",
            "enum": ["self_recorded", "authorized_multitrack", "public_domain", "copyright_restricted", "unknown"]
          },
          "difficulty": {
            "type": "object",
            "properties": {
              "spectralOverlapRatio": { "type": "number", "minimum": 0, "maximum": 1 },
              "accompanimentDensity": { "type": "number", "minimum": 0 },
              "stringEnergyRatio": { "type": "number", "minimum": 0, "maximum": 1 },
              "unisonStringRatio": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
