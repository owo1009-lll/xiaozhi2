PORT=3000
# Optional external analyzer service.
# When set, server.js forwards audio and score pack to POST {ERHU_ANALYZER_URL}/analyze
ERHU_ANALYZER_URL=http://127.0.0.1:8000

# Optional overrides for the fail-closed offline photo-score deployment.
# Leave unset to use the stable data/tools paths in
# config/western-photo-score-deployment.json.
# WESTERN_PHOTO_SCORE_PYTHON_EXE=C:\\path\\to\\audio-python.exe
# ERHU_AUDIVERIS_CLI=C:\\path\\to\\Audiveris.exe
# ERHU_HOMR_CLI=C:\\path\\to\\homr.exe
