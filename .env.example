PORT=3000
# Optional external analyzer service.
# When set, server.js forwards audio and score pack to POST {ERHU_ANALYZER_URL}/analyze
ERHU_ANALYZER_URL=http://127.0.0.1:8000

# Required for Mini Program user-content moderation. Keep the AppSecret and
# callback token in the local .env only; never add them to the Mini Program or
# commit them to Git.
WECHAT_MINIPROGRAM_APPID=wx_your_miniprogram_appid
WECHAT_MINIPROGRAM_SECRET=your_miniprogram_app_secret
WECHAT_CONTENT_SAFETY_PUBLIC_BASE_URL=https://api.your-domain.example
WECHAT_CONTENT_SAFETY_CALLBACK_TOKEN=generate-a-long-random-token
# Strongly recommended when the WeChat message receiver is set to safe mode.
WECHAT_CONTENT_SAFETY_ENCODING_AES_KEY=your_43_character_encoding_aes_key

# Optional overrides for the fail-closed offline photo-score deployment.
# Leave unset to use the stable data/tools paths in
# config/western-photo-score-deployment.json.
# WESTERN_PHOTO_SCORE_PYTHON_EXE=C:\\path\\to\\audio-python.exe
# ERHU_AUDIVERIS_CLI=C:\\path\\to\\Audiveris.exe
# ERHU_HOMR_CLI=C:\\path\\to\\homr.exe
