.library-note {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #17202A;
  color: #F8F4EC;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 28rpx;
}
.note-mark {
  width: 68rpx;
  height: 68rpx;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.08);
  color: #B8D0E8;
  font-size: 34rpx;
}
.note-title { font-size: 26rpx; font-weight: 700; }

.category-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 22rpx;
  padding: 7rpx;
  background: #E9EDF1;
  border-radius: 18rpx;
}
.category-tab {
  flex: 1;
  padding: 17rpx 20rpx;
  border-radius: 13rpx;
  color: #6B7580;
}
.category-tab.on {
  background: #FFFFFF;
  color: #1B2530;
  box-shadow: 0 5rpx 16rpx rgba(27, 43, 59, .08);
}
.category-name { font-size: 27rpx; font-weight: 700; }
.category-count { font-size: 19rpx; margin-top: 1rpx; color: #87919C; }
.category-tab.on .category-count { color: #527294; }

.group-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 2rpx 4rpx 18rpx;
}
.group-total {
  color: #7B858F;
  font-size: 21rpx;
}
.collapse-action {
  color: #244A73;
  font-size: 22rpx;
  font-weight: 650;
  padding: 10rpx 18rpx;
  background: #E8EEF4;
  border-radius: 999rpx;
}

.library-loading {
  text-align: center;
  color: #8C857D;
  font-size: 24rpx;
  padding: 80rpx 0;
}
.loading-disc {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  border: 5rpx solid #DFD7CC;
  border-top-color: #244A73;
  margin: 0 auto 20rpx;
  animation: spin .9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.group-block {
  background: rgba(255,255,255,.76);
  border: 1rpx solid #DEE3E8;
  border-radius: 24rpx;
  padding: 6rpx 24rpx 4rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
}
.group-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 2rpx 21rpx;
  border-bottom: 1rpx solid #E2E6EA;
}
.group-block.collapsed .group-heading { border-bottom: none; }
.group-heading-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.collapse-chevron {
  color: #607080;
  font-size: 30rpx;
  line-height: 1;
  transform: rotate(-90deg);
  transition: transform .18s ease;
}
.collapse-chevron.open { transform: rotate(0deg); }
.group-kicker {
  color: #244A73;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  font-weight: 700;
}
.group-title {
  color: #1B2027;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: 0;
  margin-top: 3rpx;
}
.st-count {
  color: #68737E;
  font-size: 22rpx;
  background: #EEF1F4;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.piece-row {
  display: flex;
  align-items: center;
  gap: 17rpx;
  padding: 23rpx 0;
  border-bottom: 1rpx solid #E5E9ED;
}
.piece-row:last-child { border-bottom: none; }
.piece-index {
  color: #9AA3AC;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
  width: 34rpx;
}
.piece-body { flex: 1; min-width: 0; }
.piece-title {
  color: #1D2228;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  font-weight: 650;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.piece-meta {
  color: #737D87;
  font-size: 20rpx;
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.page-badge {
  color: #244A73;
  background: #E8EEF4;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  white-space: nowrap;
}
.piece-arrow { color: #A79F95; font-size: 34rpx; }
.library-foot {
  color: #77818B;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
  padding: 30rpx 20rpx 10rpx;
}

.library-error {
  color: #8D4037;
  background: #F3E2DF;
  border: 1rpx solid #DFC1BC;
  border-radius: 16rpx;
  padding: 23rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
}
