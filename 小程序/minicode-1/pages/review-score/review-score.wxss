page {
  height: 100%;
  background: #10161D;
  overflow: hidden;
}

.review-page {
  height: 100vh;
  background: #10161D;
  color: #F4F7FA;
  overflow: hidden;
}

.score-swiper {
  width: 100%;
  height: 100vh;
}

.score-slide {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.review-sheet {
  width: 92vw;
  height: calc(100vh - 20px);
  margin: 10px auto;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 7px;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 8px 28px rgba(0, 0, 0, .28);
}

.zoom-area,
.zoom-view {
  width: 92vw;
  height: calc(100vh - 40px);
}

.zoom-area {
  background: #FFFFFF;
  overflow: hidden;
}

.sheet-page {
  height: 20px;
  line-height: 20px;
  color: #77818B;
  background: #F2F4F6;
  padding: 0 10px;
  font-size: 9px;
  letter-spacing: 1px;
}

.review-stage {
  width: 100%;
  position: relative;
  font-size: 0;
}

.review-image {
  width: 100%;
  height: auto;
  display: block;
}

.measure-box,
.note-box {
  position: absolute;
  box-sizing: border-box;
  pointer-events: none;
}

.measure-box {
  border: 3rpx solid #D6453E;
  background: rgba(214, 69, 62, .12);
}

.note-box {
  border: 3rpx solid #D6453E;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, .9);
}

.measure-box.pitch,
.note-box.pitch { border-color: #D6453E; }
.measure-box.pitch { background: rgba(214, 69, 62, .13); }

.measure-box.rhythm,
.note-box.rhythm { border-color: #D28A24; }
.measure-box.rhythm { background: rgba(210, 138, 36, .15); }

.measure-box.tone,
.note-box.tone { border-color: #7656A7; }
.measure-box.tone { background: rgba(118, 86, 167, .15); }

.measure-box.missing,
.note-box.missing { border-color: #2F6FA3; }
.measure-box.missing { background: rgba(47, 111, 163, .14); }

.issue-label {
  position: absolute;
  left: -2rpx;
  top: -28rpx;
  color: #FFFFFF;
  background: #D6453E;
  border-radius: 5rpx;
  padding: 3rpx 8rpx;
  font-size: 15rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.issue-label.rhythm { background: #D28A24; }
.issue-label.tone { background: #7656A7; }
.issue-label.missing { background: #2F6FA3; }

.back-button {
  position: fixed;
  z-index: 20;
  left: 12px;
  top: 12px;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: rgba(16, 22, 29, .84);
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 50%;
  font-size: 30px;
  line-height: 1;
}

.score-hud {
  position: fixed;
  z-index: 15;
  left: 56px;
  top: 12px;
  max-width: 285px;
  padding: 7px 12px;
  color: #F4F7FA;
  background: rgba(16, 22, 29, .84);
  border: 1rpx solid rgba(255, 255, 255, .14);
  border-radius: 9px;
  backdrop-filter: blur(8px);
}

.hud-title {
  max-width: 285px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  font-weight: 700;
}

.hud-meta {
  color: #AEB9C4;
  font-size: 10px;
}

.issue-legend {
  position: fixed;
  z-index: 15;
  right: 12px;
  top: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 11px;
  color: #D8E0E7;
  background: rgba(16, 22, 29, .84);
  border: 1rpx solid rgba(255, 255, 255, .14);
  border-radius: 9px;
  font-size: 10px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
}

.legend-dot {
  width: 8px;
  height: 8px;
  display: inline-block;
  border-radius: 50%;
}

.legend-dot.pitch { background: #D6453E; }
.legend-dot.rhythm { background: #D28A24; }
.legend-dot.tone { background: #7656A7; }
.legend-dot.missing { background: #2F6FA3; }

.zoom-controls {
  position: fixed;
  z-index: 25;
  right: 14px;
  bottom: calc(18px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  color: #FFFFFF;
  background: rgba(16, 22, 29, .88);
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 5px 18px rgba(0, 0, 0, .25);
}

.zoom-button,
.zoom-value {
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.zoom-button {
  width: 42px;
  font-size: 24px;
}

.zoom-value {
  min-width: 58px;
  padding: 0 5px;
  color: #D6DEE6;
  border-left: 1rpx solid rgba(255, 255, 255, .14);
  border-right: 1rpx solid rgba(255, 255, 255, .14);
  font-size: 11px;
}

.score-loading {
  position: fixed;
  z-index: 12;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 15px;
  color: #58636E;
  background: rgba(255, 255, 255, .94);
  border: 1rpx solid #E0E5E9;
  border-radius: 12px;
  box-shadow: 0 6px 22px rgba(0, 0, 0, .14);
  font-size: 12px;
}

.loading-ring {
  width: 14px;
  height: 14px;
  border: 2px solid #D6DDE3;
  border-top-color: #244A73;
  border-radius: 50%;
  animation: score-spin .8s linear infinite;
}

@keyframes score-spin {
  to { transform: rotate(360deg); }
}

.page-indicator {
  position: fixed;
  z-index: 20;
  left: 50%;
  bottom: calc(22px + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  color: #D6DEE6;
  background: rgba(16, 22, 29, .84);
  border: 1rpx solid rgba(255, 255, 255, .15);
  border-radius: 999px;
  padding: 5px 12px;
  font-size: 10px;
}

.review-empty {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8F9BA7;
  font-size: 23rpx;
}
